# Copy to .env and fill in:  cp .env.example .env

# --- LLM provider ------------------------------------------------------------
LLM_PROVIDER=gemini               # gemini | openai | openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash     # used by all agents
# GEMINI_BUILDER_MODEL=           # optional: different model for Agent 4 (pitch + prototype)
#                                 # e.g. gemini-3.5-flash-lite for a faster, cheaper run

OPENAI_API_KEY=
OPENAI_MODEL=                     # required when LLM_PROVIDER=openai
# OPENAI_BUILDER_MODEL=

# OpenRouter (OpenAI-compatible). Models ending in ':free' cost nothing but have a daily request limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free   # alt: google/gemma-4-31b-it:free
# OPENROUTER_BUILDER_MODEL=
# Tried in order when the main model is rate-limited or down upstream:
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,openrouter/free

# Thinking depth, mapped to Gemini thinking levels: minimal | low | medium | high | xhigh | max
LLM_EFFORT=medium                 # research, ideation, memo and pitch text
BUILDER_EFFORT=high               # rubric scoring and the prototype

# --- Web search (optional; the chain is Tavily -> Serper -> DuckDuckGo) -------
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_RESULTS_PER_QUERY=5

# --- Deep research (Stage 1) -------------------------------------------------
# Cheap model that turns each fetched page/PDF into dated facts (main agents never see raw pages).
# CHEAP_MODEL=                     # overrides the per-provider default below
# OPENROUTER_CHEAP_MODEL=google/gemma-4-31b-it:free
# GEMINI_CHEAP_MODEL=              # default: the builder model
# OPENAI_CHEAP_MODEL=
MAX_DOCS=6                         # full pages/PDFs read per run
RESEARCH_TIME_BUDGET_S=120         # stage 1 time box; stops reading new documents after this
GAP_ROUND=true                     # one follow-up search round for missing/stale fields (skipped when data quality is high)

# --- Rubric weights (normalized automatically) -------------------------------
WEIGHT_ROI=0.30
WEIGHT_CEO_RELEVANCE=0.25        # fit with the CEO's stated priorities and the core business
WEIGHT_FEASIBILITY=0.20
WEIGHT_SPEED=0.15
WEIGHT_MOAT=0.10

# --- Stage 4 ------------------------------------------------------------------
BUILD_PROTOTYPE=true              # also build 04_prototype.html (slower); CLI: --no-prototype

# --- Misc --------------------------------------------------------------------
MAX_VALIDATION_RETRIES=2          # repair attempts when the model returns invalid JSON
# OUTPUTS_DIR=./outputs
# Cost tracking: USD per 1M tokens for your model (or edit PRICES_PER_MTOK in utils/costs.py).
# Without these, tokens are still counted and cost shows as "n/a".
# PRICE_INPUT_PER_MTOK=
# PRICE_OUTPUT_PER_MTOK=
