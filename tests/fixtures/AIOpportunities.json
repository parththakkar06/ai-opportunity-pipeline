{
  "business_name": "Maple Street Dental",
  "opportunities": [
    {
      "id": "opp-1",
      "title": "No-show prediction & smart waitlist backfill",
      "category": "revenue_growth",
      "problem_solved": "Empty hygiene chairs from late cancellations",
      "ai_mechanism": "Gradient-boosted model scores each appointment's no-show risk from history; high-risk slots trigger SMS confirmations and auto-offer to waitlist patients.",
      "why_this_business": "Two locations and reviews citing slow rebooking",
      "estimated_effort": {
        "level": "medium",
        "timeline_weeks": 6,
        "team": "1 engineer + booking API"
      },
      "estimated_impact": {
        "summary": "Recover 30% of lost slots",
        "primary_metric": "Chair utilization",
        "annual_value_usd_low": 60000,
        "annual_value_usd_high": 110000,
        "basis": "~100 no-shows/mo x 30% x $180"
      },
      "required_data": [
        "2 years of appointment history"
      ],
      "risks": [
        "Booking system API limits"
      ],
      "addresses_challenges": [
        "ch-1"
      ],
      "applies_to": "Hygiene schedule at both clinics",
      "build_vs_buy": {
        "decision": "hybrid",
        "vendors": [
          "Open Dental",
          "Twilio",
          "DentalBot Pro"
        ],
        "rationale": "Read the schedule from the practice system and text the waitlist; build only the no-show model."
      },
      "pilot_30_60_90": [
        {
          "day": 30,
          "milestone": "Model trained on 12 months of appointments",
          "kpi": "No-show prediction AUC",
          "target": "≥ 0.70"
        },
        {
          "day": 60,
          "milestone": "Waitlist backfill live at Austin",
          "kpi": "Empty hygiene slots per week",
          "target": "from 25 to 18"
        },
        {
          "day": 90,
          "milestone": "Both clinics",
          "kpi": "Hygiene chair utilization",
          "target": "from 82% to 88%"
        }
      ],
      "data_readiness": [
        {
          "source": "Appointment history",
          "status": "have",
          "reason": "Practice-management system keeps every booking"
        },
        {
          "source": "Waitlist",
          "status": "likely",
          "reason": "Front desk keeps one, maybe on paper"
        }
      ],
      "compliance": [
        {
          "rule_id": "hipaa",
          "note": "Appointment data is patient information; the texting vendor needs a BAA."
        },
        {
          "rule_id": "tcpa",
          "note": "Backfill texts need patient consent and an opt-out."
        },
        {
          "rule_id": "gdpr",
          "note": "EU data rules"
        }
      ]
    },
